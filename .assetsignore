# Files in the repo root that must not be served as part of the site.
# Wrangler reads this from the assets directory (./, set in wrangler.jsonc)
# and excludes these from what it uploads. gitignore syntax.
#
# This only filters the upload, not the build: Cloudflare still runs
# scripts/generate-gallery-manifest.js in the checkout, and the
# library/manifest.json it writes is served as normal.
CLAUDE.md
.assetsignore
README.md
wrangler.jsonc
.gitignore
scripts/
